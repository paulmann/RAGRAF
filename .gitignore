# RAGRAF — .gitignore корня проекта.
#
# Правила разбиты по причинам: у каждой группы своё обоснование, потому что
# «на всякий случай» здесь не работает — исключение наугад выбросило бы из
# репозитория рабочий файл, и это не было бы видно.

# --------------------------------------------------------------------------
# 1. Индекс RAGRAF. Машинно-локальный: зависит от этой машины, пересобирается
#    автоматически, в чужом клоне не нужен. Размер делает ошибку дорогой —
#    измерено: 537 МБ только на корпусе самого RAGRAF, до 1,6 ГБ на других.
#    Требование §8.20 правил проекта: правило обязательно в корне репозитория.
.ragraf/

# --------------------------------------------------------------------------
# 2. Реестр разработок и настройки — данные МАШИНЫ, а не продукта. В реестре
#    лежат имена и локальные пути всех корпусов этой машины. Создаются
#    автоматически при первом обращении (catalog.py, settings.py).
catalog/catalog.json
catalog/catalog.json.*
catalog/settings.json

# --------------------------------------------------------------------------
# 3. Конфигурации локальных корпусов. Это рабочие конфиги конкретных
#    проектов с локальными путями; продукту они не принадлежат. Пример
#    конфигурации для своего проекта лежит отдельно (examples/).
#
#    Слэш в начале обязателен: без него правило «config/» задевало бы ЛЮБОЙ
#    каталог с таким именем на любой глубине — в том числе фикстуру тестов
#    tests/fixtures/proj/config/. Это не теория: проверено командой
#    `git check-ignore -v`, которая указала именно на эту строку.
/config/

# --------------------------------------------------------------------------
# 4. Внешние инструменты и зависимости: машинно-локальные, гигабайты.
#    .tools — распакованные JDK и Joern (5,2 ГБ), .ort_gpu_probe — скопированные
#    библиотеки ONNX/CUDA (1,9 ГБ), .venv — виртуальное окружение.
.tools/
.ort_gpu_probe/
.venv/
venv/
env/

# --------------------------------------------------------------------------
# 5. Служебное агента и сессий разработки. .staging содержит рабочие фикстуры
#    и секретоносные материалы прогонов (*.pem) — публикации не подлежит.
.zwork/
.staging/
.dev_agent/
agents/

# --------------------------------------------------------------------------
# 6. Сборка и кэши Python.
*.egg-info/
__pycache__/
*.py[cod]
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.coverage
htmlcov/

# --------------------------------------------------------------------------
# 7. Рабочие данные Joern (бинарные файлы графа свойств кода).
workspace/

# --------------------------------------------------------------------------
# 8. Маркер интерпретатора: содержит абсолютный путь этой машины.
.interpreter

# --------------------------------------------------------------------------
# 9. Копии и временные файлы. Копия рядом с рабочим файлом — источник
#    устаревших фактов: чтец по маске увидит обе версии и не отличит
#    рабочую от прежней.
*.bak
*.bak.*
*.bak-*
*.before
*.after
*.orig
*.old
*.save
*.rej
*.tmp
*.log
~$*
Thumbs.db
Desktop.ini

# --------------------------------------------------------------------------
# 10. Секреты и локальные настройки. В этом проекте таких файлов нет
#     (реквизиты в config/*.yaml отсутствуют, токен панели генерируется
#     в рантайме), но правила стоят заранее: появление секрета не должно
#     требовать правки .gitignore в тот же момент.
*.local.php
.local.*
.env
.env.*
*.pem
*.key
*.pfx
*.p12
credential*.json

# --------------------------------------------------------------------------
# 11. Явные исключения из исключений. Файл-фикстура тестов подпадает под
#     правило *.local.php выше, но это НЕ секрет, а синтетический маркер
#     ('FIXTURE_VALUE_SENTINEL_42'), на котором проверяется механизм
#     secrets_exclude. Без него тест не может доказать, что секретоносные
#     файлы действительно пропускаются индексатором.
!tests/fixtures/proj/config/app.local.php
